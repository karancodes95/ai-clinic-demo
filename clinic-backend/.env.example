# Copy to .env and fill in. See README for setup.

# Postgres. The API connects as the non-privileged demo_app role (created by schema.sql).
DATABASE_URL=postgresql://demo_app@localhost:5432/clinic_demo
# Applying schema.sql / seeding connects as the DB owner (e.g. your local superuser).
MIGRATIONS_DATABASE_URL=postgresql://postgres@localhost:5432/clinic_demo

# Static API key gating the chat + data endpoints (low-value demo gate by design).
API_KEY=dev-only-static-key-change-me

# Vertical served by this backend.
VERTICAL=healthcare

# LLM provider: "gemini" (needs GEMINI_API_KEY) or "claude" (Claude Agent SDK,
# uses your local Claude Code login / CLAUDE_CODE_OAUTH_TOKEN, no API key).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
# CLAUDE_MODEL=              # empty = Agent SDK default

# Slack incoming-webhook for /leads + /leads/public notifications. Empty disables.
SLACK_WEBHOOK_URL=

# Cloudflare Turnstile secret key for /leads/public verification.
# Get from Cloudflare dashboard -> Turnstile -> your site -> "Secret key".
# Empty disables /leads/public (it refuses all submissions).
TURNSTILE_SECRET_KEY=

# Admin auth (bearer-login flow for the admin surface). Generate the hash with:
#   .venv/bin/python tool/hash_admin_password.py
# ADMIN_JWT_SECRET: 32+ random hex bytes. All empty = admin login disabled.
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=

# Production CORS allowlist (comma-separated origins). For a GitHub Pages demo,
# set to your Pages origin, e.g. https://<username>.github.io
# Empty falls back to "*" (dev only).
ALLOWED_ORIGINS=
